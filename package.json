{
  "name": "devmatch",
  "version": "1.0.0",
  "private": true,
  "description": "DevMatch - semantic contributor-to-issue matching (Next.js + PostgreSQL/pgvector + MongoDB)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx scripts/init-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/init-db.ts --reset && tsx scripts/seed.ts",
    "db:reindex": "tsx scripts/reindex.ts",
    "test": "node --import tsx --test --test-reporter=spec tests/embedder.test.ts tests/db.test.ts",
    "test:e2e": "node tests/e2e.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "jose": "^6.2.14",
    "mongodb": "^7.8.0",
    "next": "^15.5.28",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
